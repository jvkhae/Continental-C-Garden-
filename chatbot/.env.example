# Facebook Page access token (Meta App → Messenger → Access Tokens)
PAGE_ACCESS_TOKEN=

# Any string you choose — must match what you enter in the Meta webhook setup UI
VERIFY_TOKEN=

# Meta App Secret (App Dashboard → Settings → Basic) — used to verify webhook signatures
APP_SECRET=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional
GRAPH_API_VERSION=v21.0
PORT=8080
